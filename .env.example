APP_URL=http://localhost:8888/zubari/dental-template

DB_HOST=127.0.0.1
DB_PORT=8889
DB_NAME=dental_booking
DB_USER=root
DB_PASSWORD=root

# Optional values used by `php backend/init_admin.php`.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_CLINIC_ID=
# Optional: required by the web setup page when proxy headers are present,
# or whenever a deployment explicitly configures a setup key.
ADMIN_SETUP_KEY=

# SMTP values are optional. If they are absent, booking requests are saved
# but notifications are reported as not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SmileCraft Dental
